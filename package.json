{
  "name": "claude-rescue-reader-ci",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "validate": "node scripts/validate-viewer.mjs",
    "build:offline": "node scripts/build-offline-bundle.mjs",
    "privacy": "node scripts/privacy-guard.mjs",
    "policy": "node scripts/pr-policy.mjs",
    "docs": "node scripts/check-docs.mjs",
    "capture:readme": "node scripts/capture-readme-screenshots.mjs",
    "capture:demo-gif": "node scripts/capture-readme-demo-gif.mjs",
    "benchmark:readme": "node scripts/benchmark-readme-performance.mjs",
    "benchmark:analytics": "node scripts/benchmark-analytics-performance.mjs",
    "build:demo": "node scripts/build-synthetic-demo.mjs",
    "test:smoke": "npm run test:benchmark && npm run test:policy && npm run test:worker-core && playwright test tests/browser-smoke.spec.mjs tests/analytics.spec.mjs tests/worker-performance.spec.mjs tests/rendering-recovery.spec.mjs tests/worker-pipelines.spec.mjs tests/export-packages.spec.mjs",
    "test:benchmark": "node --test tests/benchmark-utils.test.mjs",
    "test:policy": "node --test tests/viewer-policy.test.mjs",
    "test:offline": "playwright test tests/offline-release.spec.mjs",
    "test:worker-core": "node --test tests/worker-core.test.mjs tests/export-format.test.mjs tests/redaction.test.mjs"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@playwright/test": "1.62.1",
    "highlight.js": "^11.11.1",
    "jszip": "3.10.1",
    "marked": "^18.0.11",
    "mermaid": "^12.2.0"
  }
}
